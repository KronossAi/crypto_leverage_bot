"""
Calcul des indicateurs techniques — Version compatible avec la bibliothèque 'ta'.
"""
import logging
from typing import Optional
import pandas as pd
# On utilise les imports spécifiques de la bibliothèque 'ta'
from ta.trend import EMAIndicator, MACD
from ta.momentum import RSIIndicator
from ta.volatility import BollingerBands, AverageTrueRange
import numpy as np

logger = logging.getLogger(__name__)

def _to_df(ohlcv: list[list]) -> Optional[pd.DataFrame]:
    """Convertit une liste OHLCV en DataFrame pandas"""
    if not ohlcv or len(ohlcv) < 50:
        return None
    df = pd.DataFrame(ohlcv, columns=["ts", "open", "high", "low", "close", "volume"])
    df = df.astype({
        "open": float, "high": float, "low": float,
        "close": float, "volume": float
    })
    return df

# ─── TREND FOLLOWING ─────────────────────────────────────────────────────────

def calc_trend(ohlcv: list[list], cfg: dict) -> Optional[dict]:
    df = _to_df(ohlcv)
    if df is None: return None
    try:
        close = df["close"]
        # Ici on garde 'window' car la bibliothèque 'ta' l'exige
        ema_fast = EMAIndicator(close=close, window=cfg["ema_fast"]).ema_indicator().iloc[-1]
        ema_slow = EMAIndicator(close=close, window=cfg["ema_slow"]).ema_indicator().iloc[-1]
        ema_trend = EMAIndicator(close=close, window=cfg["ema_trend"]).ema_indicator().iloc[-1]
        
        macd_obj = MACD(
            close=close,
            window_fast=cfg["macd_fast"],
            window_slow=cfg["macd_slow"],
            window_sign=cfg["macd_signal"]
        )
        
        price = close.iloc[-1]
        bias = "long" if price > ema_trend else "short"
        
        return {
            "bias": bias,
            "ema_fast": round(ema_fast, 6),
            "ema_slow": round(ema_slow, 6),
            "ema_trend": round(ema_trend, 6),
            "macd_line": round(macd_obj.macd().iloc[-1], 6),
            "macd_signal": round(macd_obj.macd_signal().iloc[-1], 6),
            "macd_hist": round(macd_obj.macd_diff().iloc[-1], 6),
            "ema_cross_up": ema_fast > ema_slow,
            "macd_cross_up": macd_obj.macd().iloc[-1] > macd_obj.macd_signal().iloc[-1],
            "price": price,
        }
    except Exception as e:
        logger.error(f"calc_trend error: {e}")
        return None

# ─── MEAN REVERSION ──────────────────────────────────────────────────────────

def calc_mean_reversion(ohlcv: list[list], cfg: dict) -> Optional[dict]:
    df = _to_df(ohlcv)
    if df is None: return None
    try:
        close = df["close"]
        bb = BollingerBands(close=close, window=cfg["bb_period"], window_dev=cfg["bb_std"])
        
        upper = bb.bollinger_hband().iloc[-1]
        lower = bb.bollinger_lband().iloc[-1]
        mid   = bb.bollinger_mavg().iloc[-1]
        rsi   = RSIIndicator(close=close, window=cfg["rsi_period"]).rsi().iloc[-1]
        
        price = close.iloc[-1]
        return {
            "price": price,
            "bb_upper": round(upper, 6),
            "bb_lower": round(lower, 6),
            "rsi": round(rsi, 2),
            "is_ranging": ((upper - lower) / mid) < 0.04,
            "near_upper": price >= upper * 0.998,
            "near_lower": price <= lower * 1.002,
            "oversold": rsi <= cfg["rsi_oversold"],
            "overbought": rsi >= cfg["rsi_overbought"],
        }
    except Exception as e:
        logger.error(f"calc_mean_reversion error: {e}")
        return None

# ─── MOMENTUM / BREAKOUT ─────────────────────────────────────────────────────

def calc_momentum(ohlcv: list[list], cfg: dict) -> Optional[dict]:
    df = _to_df(ohlcv)
    if df is None: return None
    try:
        close, high, low = df["close"], df["high"], df["low"]
        # Correction de l'erreur ATR : on utilise l'objet AverageTrueRange
        atr_val = AverageTrueRange(high=high, low=low, close=close, window=cfg["atr_period"]).average_true_range().iloc[-1]
        
        lb = cfg["breakout_lookback"]
        range_high = high.iloc[-lb-1:-1].max()
        range_low = low.iloc[-lb-1:-1].min()
        
        price = close.iloc[-1]
        return {
            "price": price,
            "atr": round(atr_val, 6),
            "breakout_up": price > range_high,
            "breakout_down": price < range_low,
            "rsi": round(RSIIndicator(close=close, window=14).rsi().iloc[-1], 2)
        }
    except Exception as e:
        logger.error(f"calc_momentum error: {e}")
        return None

# ─── ATR UTILITAIRE ─────────────────────────────────────────────────────────

def get_atr(ohlcv: list[list], period: int = 14) -> Optional[float]:
    df = _to_df(ohlcv)
    if df is None: return None
    try:
        return AverageTrueRange(high=df["high"], low=df["low"], close=df["close"], window=period).average_true_range().iloc[-1]
    except Exception as e:
        logger.error(f"get_atr error: {e}")
        return None