"""
Scalp Order Flow — Footprint & Delta Analysis
─────────────────────────────────────────────────────────────
Source    : Binance Futures aggTrades (déjà dans feed.py)
Exécution : Hyperliquid uniquement (aucun ordre ici)
"""
import logging
import time
from collections import deque
from dataclasses import dataclass, field
from typing import Optional

import numpy as np

logger = logging.getLogger(__name__)


@dataclass
class CandleDelta:
    ts:           int
    open:         float
    high:         float
    low:          float
    close:        float
    volume:       float
    buy_volume:   float
    sell_volume:  float
    delta:        float
    delta_pct:    float
    trade_count:  int


@dataclass
class OrderFlowSignal:
    symbol:               str
    timestamp:            int
    side:                 Optional[str]  = None
    score:                int            = 0
    reasons:              list           = field(default_factory=list)
    cvd_hidden_bull_div:  bool           = False
    cvd_hidden_bear_div:  bool           = False
    delta_exhaustion:     bool           = False
    stacked_imbalance:    Optional[str]  = None
    absorption_detected:  bool           = False
    absorption_side:      Optional[str]  = None
    naked_poc_nearby:     bool           = False
    naked_poc_level:      Optional[float]= None
    hvn_rejection:        bool           = False


class FootprintEngine:
    def __init__(
        self,
        symbol:            str,
        candle_window:     int   = 50,
        price_precision:   int   = 2,
        absorption_pct:    float = 0.05,
        absorption_vol_x:  float = 3.0,
        stacked_min:       int   = 3,
        exhaustion_vol_x:  float = 2.0,
        exhaustion_pct:    float = 0.3,
        poc_tolerance_pct: float = 0.002,
    ):
        self.symbol           = symbol
        self.candle_window    = candle_window
        self.price_precision  = price_precision
        self.absorption_pct   = absorption_pct
        self.absorption_vol_x = absorption_vol_x
        self.stacked_min      = stacked_min
        self.exhaustion_vol_x = exhaustion_vol_x
        self.exhaustion_pct   = exhaustion_pct
        self.poc_tolerance    = poc_tolerance_pct

        self._candles: deque[CandleDelta] = deque(maxlen=candle_window)
        self._current_candle: Optional[dict] = None
        self._current_tf_seconds: int = 60
        self._cvd: deque[float] = deque(maxlen=candle_window)
        self._cvd_running: float = 0.0
        self._session_poc: Optional[float] = None
        self._session_volume_profile: dict[float, float] = {}

    def on_trade(self, price: float, qty: float, is_buyer_maker: bool, timestamp_ms: int):
        try:
            buy_vol  = 0.0 if is_buyer_maker else qty
            sell_vol = qty if is_buyer_maker else 0.0
            delta    = buy_vol - sell_vol
            self._cvd_running += delta
            price_level = round(price, self.price_precision)
            self._session_volume_profile[price_level] = (
                self._session_volume_profile.get(price_level, 0.0) + qty
            )
            ts_candle = (timestamp_ms // (self._current_tf_seconds * 1000)) * \
                        (self._current_tf_seconds * 1000)
            if self._current_candle is None:
                self._current_candle = self._new_candle(ts_candle, price)
            if ts_candle != self._current_candle["ts"]:
                self._close_candle()
                self._current_candle = self._new_candle(ts_candle, price)
            c = self._current_candle
            c["high"]        = max(c["high"], price)
            c["low"]         = min(c["low"], price)
            c["close"]       = price
            c["volume"]     += qty
            c["buy_volume"] += buy_vol
            c["sell_volume"]+= sell_vol
            c["delta"]      += delta
            c["trade_count"]+= 1
        except Exception as e:
            logger.error(f"FootprintEngine.on_trade {self.symbol}: {e}")

    def _new_candle(self, ts: int, price: float) -> dict:
        return {
            "ts": ts, "open": price, "high": price, "low": price,
            "close": price, "volume": 0.0, "buy_volume": 0.0,
            "sell_volume": 0.0, "delta": 0.0, "trade_count": 0,
        }

    def _close_candle(self):
        if not self._current_candle or self._current_candle["volume"] == 0:
            return
        c   = self._current_candle
        vol = c["volume"]
        self._candles.append(CandleDelta(
            ts          = c["ts"],
            open        = c["open"],
            high        = c["high"],
            low         = c["low"],
            close       = c["close"],
            volume      = vol,
            buy_volume  = c["buy_volume"],
            sell_volume = c["sell_volume"],
            delta       = c["delta"],
            delta_pct   = c["delta"] / vol if vol > 0 else 0.0,
            trade_count = c["trade_count"],
        ))
        self._cvd.append(self._cvd_running)
        self._update_session_poc()

    def _update_session_poc(self):
        if not self._session_volume_profile:
            return
        try:
            self._session_poc = max(
                self._session_volume_profile,
                key=self._session_volume_profile.get
            )
        except Exception as e:
            logger.error(f"_update_session_poc {self.symbol}: {e}")

    def analyze(self, current_price: float) -> OrderFlowSignal:
        signal = OrderFlowSignal(symbol=self.symbol, timestamp=int(time.time() * 1000))
        if len(self._candles) < 10:
            return signal
        candles  = list(self._candles)
        cvd_list = list(self._cvd)
        try:
            self._detect_cvd_divergence(signal, candles, cvd_list)
            self._detect_delta_exhaustion(signal, candles)
            self._detect_stacked_imbalance(signal, candles)
            self._detect_absorption(signal, candles)
            self._detect_naked_poc(signal, current_price)
            self._detect_hvn_rejection(signal, candles, current_price)
            self._compute_score(signal)
        except Exception as e:
            logger.error(f"FootprintEngine.analyze {self.symbol}: {e}")
        return signal

    def _detect_cvd_divergence(self, signal, candles, cvd_list):
        if len(candles) < 6 or len(cvd_list) < 6:
            return
        try:
            recent_lows  = [c.low  for c in candles[-3:]]
            recent_highs = [c.high for c in candles[-3:]]
            prev_lows    = [c.low  for c in candles[-6:-3]]
            prev_highs   = [c.high for c in candles[-6:-3]]
            recent_cvd   = np.mean(cvd_list[-3:])
            prev_cvd     = np.mean(cvd_list[-6:-3])
            if min(recent_lows) < min(prev_lows) and recent_cvd > prev_cvd:
                signal.cvd_hidden_bull_div = True
                signal.reasons.append(
                    f"CVD Hidden Bull Div: prix LL / CVD HL "
                    f"(cvd={recent_cvd:.2f} > {prev_cvd:.2f})"
                )
            if max(recent_highs) > max(prev_highs) and recent_cvd < prev_cvd:
                signal.cvd_hidden_bear_div = True
                signal.reasons.append(
                    f"CVD Hidden Bear Div: prix HH / CVD LH "
                    f"(cvd={recent_cvd:.2f} < {prev_cvd:.2f})"
                )
        except Exception as e:
            logger.error(f"_detect_cvd_divergence {self.symbol}: {e}")

    def _detect_delta_exhaustion(self, signal, candles):
        if len(candles) < 5:
            return
        try:
            avg_vol = np.mean([c.volume for c in candles[:-1]])
            for i in range(len(candles) - 2, max(len(candles) - 5, 0), -1):
                peak = candles[i]
                nxt  = candles[i + 1]
                if peak.volume > avg_vol * self.exhaustion_vol_x and \
                   abs(nxt.delta_pct) < self.exhaustion_pct:
                    signal.delta_exhaustion = True
                    signal.reasons.append(
                        f"Delta Exhaustion: vol={peak.volume:.2f} "
                        f"({peak.volume/avg_vol:.1f}x) | "
                        f"delta_next={nxt.delta_pct:.3f}"
                    )
                    break
        except Exception as e:
            logger.error(f"_detect_delta_exhaustion {self.symbol}: {e}")

    def _detect_stacked_imbalance(self, signal, candles):
        if len(candles) < self.stacked_min:
            return
        try:
            recent = candles[-self.stacked_min:]
            if all(c.delta > 0 for c in recent):
                signal.stacked_imbalance = "bull"
                signal.reasons.append(
                    f"Stacked Imbalance BULL: {self.stacked_min} bougies "
                    f"delta+ (total={sum(c.delta for c in recent):.2f})"
                )
            elif all(c.delta < 0 for c in recent):
                signal.stacked_imbalance = "bear"
                signal.reasons.append(
                    f"Stacked Imbalance BEAR: {self.stacked_min} bougies "
                    f"delta- (total={sum(c.delta for c in recent):.2f})"
                )
        except Exception as e:
            logger.error(f"_detect_stacked_imbalance {self.symbol}: {e}")

    def _detect_absorption(self, signal, candles):
        if len(candles) < 3:
            return
        try:
            avg_vol = np.mean([c.volume for c in candles[:-1]])
            last    = candles[-1]
            if last.volume > avg_vol * self.absorption_vol_x and \
               abs(last.close - last.open) / last.open < self.absorption_pct:
                side = "bull" if last.delta > 0 else "bear"
                signal.absorption_detected = True
                signal.absorption_side     = side
                signal.reasons.append(
                    f"Absorption {side.upper()}: vol={last.volume:.2f} "
                    f"({last.volume/avg_vol:.1f}x) | delta={last.delta:.2f}"
                )
        except Exception as e:
            logger.error(f"_detect_absorption {self.symbol}: {e}")

    def _detect_naked_poc(self, signal, current_price):
        if self._session_poc is None:
            return
        try:
            dist = abs(current_price - self._session_poc) / current_price
            if dist < 0.01:
                signal.naked_poc_nearby = True
                signal.naked_poc_level  = self._session_poc
                signal.reasons.append(
                    f"Naked POC @ {self._session_poc:.4f} "
                    f"(dist={dist*100:.3f}%)"
                )
        except Exception as e:
            logger.error(f"_detect_naked_poc {self.symbol}: {e}")

    def _detect_hvn_rejection(self, signal, candles, current_price):
        if len(candles) < 10 or not self._session_volume_profile:
            return
        try:
            vols = list(self._session_volume_profile.values())
            hvn_threshold = np.percentile(vols, 80)
            hvn_levels = [
                lvl for lvl, vol in self._session_volume_profile.items()
                if vol >= hvn_threshold
            ]
            last = candles[-1]
            for hvn in hvn_levels:
                wick_touched  = last.low <= hvn <= last.high
                body_rejected = not (
                    min(last.open, last.close) <= hvn <= max(last.open, last.close)
                )
                if wick_touched and body_rejected:
                    signal.hvn_rejection = True
                    signal.reasons.append(f"HVN Rejection @ {hvn:.4f}")
                    break
        except Exception as e:
            logger.error(f"_detect_hvn_rejection {self.symbol}: {e}")

    def _compute_score(self, signal):
        score = 0
        bull_votes = bear_votes = 0
        if signal.cvd_hidden_bull_div:
            score += 25; bull_votes += 1
        if signal.cvd_hidden_bear_div:
            score += 25; bear_votes += 1
        if signal.delta_exhaustion:
            score += 20
        if signal.absorption_detected:
            score += 20
            if signal.absorption_side == "bull": bull_votes += 1
            else: bear_votes += 1
        if signal.stacked_imbalance == "bull":
            score += 15; bull_votes += 1
        elif signal.stacked_imbalance == "bear":
            score += 15; bear_votes += 1
        if signal.naked_poc_nearby:
            score += 10
        if signal.hvn_rejection:
            score += 10
        if bull_votes > bear_votes:   signal.side = "long"
        elif bear_votes > bull_votes: signal.side = "short"
        else:                         signal.side = None
        signal.score = min(score, 100)
        if score > 0:
            logger.info(
                f"[OrderFlow] {signal.symbol} | Score: {score} | "
                f"Side: {signal.side} | {' | '.join(signal.reasons[:2])}"
            )


class TapeReader:
    """
    Tape Reading automatisé depuis aggTrades Binance.
    Détecte :
      - Large Print (trade > 5x taille moyenne)
      - Aggressive Sequence (10+ orders consécutifs même sens)
      - Iceberg Detection (volume >> orderbook visible)
      - Speed of Tape (accélération flux)
      - Trade Size Distribution (spike taille moyenne)
    """

    def __init__(
        self,
        symbol:              str,
        window:              int   = 200,
        large_print_x:       float = 5.0,
        aggressive_seq_min:  int   = 10,
        speed_window:        int   = 20,
        iceberg_vol_x:       float = 3.0,
    ):
        self.symbol             = symbol
        self.large_print_x      = large_print_x
        self.aggressive_seq_min = aggressive_seq_min
        self.speed_window       = speed_window
        self.iceberg_vol_x      = iceberg_vol_x

        # Historique des trades
        self._trades: deque[dict] = deque(maxlen=window)
        # Séquence consécutive en cours
        self._current_seq_side:  Optional[str] = None
        self._current_seq_count: int           = 0

    def on_trade(
        self,
        price:          float,
        qty:            float,
        is_buyer_maker: bool,
        timestamp_ms:   int,
    ):
        """Ingère un aggTrade et met à jour les compteurs"""
        try:
            side = "sell" if is_buyer_maker else "buy"
            self._trades.append({
                "price": price,
                "qty":   qty,
                "side":  side,
                "ts":    timestamp_ms,
            })
            # Mise à jour séquence agressive
            if self._current_seq_side == side:
                self._current_seq_count += 1
            else:
                self._current_seq_side  = side
                self._current_seq_count = 1
        except Exception as e:
            logger.error(f"TapeReader.on_trade {self.symbol}: {e}")

    def analyze(self) -> dict:
        """
        Analyse le tape et retourne un dict de signaux.
        Retourne un dict vide si pas assez de données.
        """
        result = {
            "large_print":        False,
            "large_print_side":   None,
            "large_print_size":   0.0,
            "aggressive_seq":     False,
            "aggressive_seq_side":None,
            "aggressive_seq_count":0,
            "iceberg":            False,
            "iceberg_side":       None,
            "speed_spike":        False,
            "size_spike":         False,
            "score":              0,
            "side":               None,
            "reasons":            [],
        }

        if len(self._trades) < 20:
            return result

        try:
            trades   = list(self._trades)
            sizes    = [t["qty"] for t in trades]
            avg_size = np.mean(sizes) if sizes else 1.0
            last     = trades[-1]

            # ── 1. Large Print ────────────────────────────────────────────
            if last["qty"] > avg_size * self.large_print_x:
                result["large_print"]      = True
                result["large_print_side"] = last["side"]
                result["large_print_size"] = last["qty"]
                result["reasons"].append(
                    f"Large Print {last['side'].upper()}: "
                    f"{last['qty']:.4f} ({last['qty']/avg_size:.1f}x avg)"
                )

            # ── 2. Aggressive Sequence ────────────────────────────────────
            if self._current_seq_count >= self.aggressive_seq_min:
                result["aggressive_seq"]      = True
                result["aggressive_seq_side"] = self._current_seq_side
                result["aggressive_seq_count"]= self._current_seq_count
                result["reasons"].append(
                    f"Aggressive Seq {self._current_seq_side.upper()}: "
                    f"{self._current_seq_count} orders consécutifs"
                )

            # ── 3. Iceberg Detection ──────────────────────────────────────
            # Volume total récent >> taille individuelle moyenne
            recent_20  = trades[-20:]
            total_vol  = sum(t["qty"] for t in recent_20)
            buy_vol    = sum(t["qty"] for t in recent_20 if t["side"] == "buy")
            sell_vol   = total_vol - buy_vol
            if total_vol > avg_size * self.iceberg_vol_x * 20:
                iceberg_side = "buy" if buy_vol > sell_vol else "sell"
                result["iceberg"]      = True
                result["iceberg_side"] = iceberg_side
                result["reasons"].append(
                    f"Iceberg {iceberg_side.upper()}: "
                    f"vol_total={total_vol:.4f} ({total_vol/(avg_size*20):.1f}x)"
                )

            # ── 4. Speed of Tape ─────────────────────────────────────────
            if len(trades) >= self.speed_window * 2:
                recent_ts  = [t["ts"] for t in trades[-self.speed_window:]]
                prev_ts    = [t["ts"] for t in trades[-self.speed_window*2:-self.speed_window]]
                recent_dur = (recent_ts[-1] - recent_ts[0]) / 1000 or 1
                prev_dur   = (prev_ts[-1]   - prev_ts[0])   / 1000 or 1
                recent_speed = self.speed_window / recent_dur
                prev_speed   = self.speed_window / prev_dur
                if recent_speed > prev_speed * 2.0:
                    result["speed_spike"] = True
                    result["reasons"].append(
                        f"Speed Spike: {recent_speed:.1f} trades/s "
                        f"(x{recent_speed/prev_speed:.1f} vs précédent)"
                    )

            # ── 5. Trade Size Distribution ────────────────────────────────
            recent_sizes = [t["qty"] for t in trades[-10:]]
            recent_avg   = np.mean(recent_sizes) if recent_sizes else 0
            if recent_avg > avg_size * 2.0:
                result["size_spike"] = True
                result["reasons"].append(
                    f"Size Spike: avg_recent={recent_avg:.4f} "
                    f"({recent_avg/avg_size:.1f}x avg global)"
                )

            # ── Score & côté ─────────────────────────────────────────────
            score      = 0
            bull_votes = bear_votes = 0

            if result["large_print"]:
                score += 25
                if result["large_print_side"] == "buy":   bull_votes += 1
                else:                                      bear_votes += 1

            if result["aggressive_seq"]:
                score += 25
                if result["aggressive_seq_side"] == "buy": bull_votes += 1
                else:                                       bear_votes += 1

            if result["iceberg"]:
                score += 20
                if result["iceberg_side"] == "buy": bull_votes += 1
                else:                               bear_votes += 1

            if result["speed_spike"]:
                score += 15

            if result["size_spike"]:
                score += 15

            # Validation : Large Print + Aggressive Sequence même direction
            if result["large_print"] and result["aggressive_seq"] and \
               result["large_print_side"] == result["aggressive_seq_side"]:
                score += 20
                result["reasons"].append(
                    "VALIDATION: Large Print + Aggressive Seq alignés"
                )

            if bull_votes > bear_votes:   result["side"] = "long"
            elif bear_votes > bull_votes: result["side"] = "short"

            result["score"] = min(score, 100)

            if score > 0:
                logger.info(
                    f"[Tape] {self.symbol} | Score: {score} | "
                    f"Side: {result['side']} | "
                    f"{' | '.join(result['reasons'][:2])}"
                )

        except Exception as e:
            logger.error(f"TapeReader.analyze {self.symbol}: {e}")

        return result

class OrderFlowRegistry:
    def __init__(self, pairs: list[str], tf_seconds: int = 60):
        self._engines: dict[str, FootprintEngine] = {
            s: FootprintEngine(s) for s in pairs
        }
        for e in self._engines.values():
            e._current_tf_seconds = tf_seconds

        self._tape_readers: dict[str, TapeReader] = {
            s: TapeReader(s) for s in pairs
        }
    def on_trade(self, symbol, price, qty, is_buyer_maker, timestamp_ms):
        e = self._engines.get(symbol)
        if e:
            e.on_trade(price, qty, is_buyer_maker, timestamp_ms)

    def analyze(self, symbol: str, current_price: float) -> OrderFlowSignal:
        e = self._engines.get(symbol)
        if not e:
            return OrderFlowSignal(symbol=symbol, timestamp=int(time.time()*1000))
        return e.analyze(current_price)
